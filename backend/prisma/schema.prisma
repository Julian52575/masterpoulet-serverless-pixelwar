generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Pixel {
  x         Int
  y         Int
  color     String
  author    String
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  @@id([x, y])
  @@map("pixels")
}
