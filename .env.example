# Copy to .env and adjust. Loaded by the Nix dev shell and by every `just`
# recipe (`set dotenv-load`). Keep secrets out of git -- .env is ignored.

# Host ports the Traefik proxy publishes: HTTP entrypoint and dashboard.
PROXY_PORT=3000
PROXY_DASHBOARD_PORT=8080

# Container engine socket Traefik uses for service discovery.
# Rootless Podman: /run/user/<uid>/podman/podman.sock (default is Docker's).
# DOCKER_SOCK=/run/user/1000/podman/podman.sock

# Local serverless emulator ports and auth. Set explicitly: podman-compose
# does not expand ${VAR:-default}. URLs must use PROXY_PORT.
FIRESTORE_PORT=8088
PUBSUB_PORT=8085
DISCORD_CLIENT_ID=1568285849328812186
DISCORD_CLIENT_SECRET=local_secret
APP_URL=http://localhost:3000/
OAUTH_REDIRECT_URI=http://localhost:3000/api/auth/callback

# Dev only: let the frontend draw without Discord login (skips the client-side
# check and the web-proxy token check).
BYPASS_DISCORD=true

# Override where rootless Podman keeps its image/container storage.
# PODMAN_STORAGE_DIR=/home/you/.cache/podman-storage/myproject

# Set to 1 to stop the dev shell from starting a Podman API socket
# (useful in CI or headless environments).
# PODMAN_NO_SOCKET=1

# Terraform (infra/functions) reads these; CI takes them from the GitHub
# environment variables DISCORD_CLIENT_ID and APP_URL.
# TF_VAR_discord_client_id=
# TF_VAR_app_url=https://<site host>/
# TF_VAR_discord_public_key=
# TF_VAR_discord_oauth_client_secret=
# TF_VAR_discord_snapshot_webhook=
# TF_VAR_discord_bot_token=
